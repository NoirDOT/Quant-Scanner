generator client {
  provider = "prisma-client-js"
}

// For local development: uses SQLite (no setup needed)
// For Vercel deployment: change provider to "postgresql" and set DATABASE_URL to your Postgres URL
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanResult {
  id            String   @id @default(cuid())
  strategyKey   String
  strategyType  String
  symbol        String
  timeframe     String
  direction     String
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  entryPrice    Float?
  stopPrice     Float?
  targetPrice   Float?
  scannedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([symbol, timeframe])
  @@index([strategyKey])
  @@index([createdAt])
  @@map("scanner_scan_results")
}

model BacktestByGrade {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  label        String
  symbol       String
  timeframe    String
  winRate      Float
  profitFactor Float
  maxDrawdown  Float
  totalTrades  Int
  avgRR        Float   @default(0)
  gradeAPlus   Int     @default(0)
  gradeA       Int     @default(0)
  gradeBPlus   Int     @default(0)
  gradeBMinus  Int     @default(0)
  gradeC       Int     @default(0)
  avgScore     Float   @default(0)
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@index([family])
  @@map("scanner_backtest_by_grade")
}

model AlertConfigScanner {
  id            String   @id @default(cuid())
  name          String
  channel       String
  destination   String
  minScore      Float    @default(50)
  strategyTypes String   @default("all")
  symbols       String   @default("all")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@map("scanner_alert_configs")
}

model AlertLogScanner {
  id          String   @id @default(cuid())
  configId    String?
  channel     String
  destination String
  subject     String
  body        String
  status      String   @default("sent")
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("scanner_alert_logs")
}

model StressTestResult {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  symbol       String
  timeframe    String
  testResultsJson String
  passedCount  Int
  verdict      String
  score        Float
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@map("scanner_stress_test_results")
}

model ForwardTestSignal {
  id            String   @id @default(cuid())
  strategyKey   String
  family        String
  symbol        String
  timeframe     String
  direction     String
  entryPrice    Float
  stopPrice     Float
  targetPrice   Float
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  signalAt      DateTime @default(now())
  outcome       String?
  exitPrice     Float?
  exitAt        DateTime?
  rMultiple     Float?
  barsToExit    Int?

  @@index([strategyKey])
  @@index([symbol])
  @@index([signalAt])
  @@map("scanner_forward_test_signals")
}
