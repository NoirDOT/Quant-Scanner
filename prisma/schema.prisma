generator client {
  provider = "prisma-client-js"
}

// Local dev: SQLite (DATABASE_URL="file:./db/scanner.db")
// Vercel prod: Postgres (DATABASE_URL="postgresql://...")
// The build runs scripts/swap-provider.ts which flips provider to "postgresql"
// when DATABASE_URL starts with "postgres", so deploys need no manual edit.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanResult {
  id            String   @id @default(cuid())
  strategyKey   String
  strategyType  String
  symbol        String
  timeframe     String
  direction     String
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  entryPrice    Float?
  stopPrice     Float?
  targetPrice   Float?
  barTime       Int?
  scannedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([symbol, timeframe])
  @@index([strategyKey])
  @@index([createdAt])
  @@map("scanner_scan_results")
}

model BacktestByGrade {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  label        String
  symbol       String
  timeframe    String
  winRate      Float
  profitFactor Float
  maxDrawdown  Float
  totalTrades  Int
  avgRR        Float   @default(0)
  gradeAPlus   Int     @default(0)
  gradeA       Int     @default(0)
  gradeBPlus   Int     @default(0)
  gradeBMinus  Int     @default(0)
  gradeC       Int     @default(0)
  avgScore     Float   @default(0)
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@index([family])
  @@map("scanner_backtest_by_grade")
}

model AlertConfigScanner {
  id            String   @id @default(cuid())
  name          String
  channel       String
  destination   String
  minScore      Float    @default(50)
  strategyTypes String   @default("all")
  symbols       String   @default("all")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@map("scanner_alert_configs")
}

model AlertLogScanner {
  id          String   @id @default(cuid())
  configId    String?
  channel     String
  destination String
  subject     String
  body        String
  status      String   @default("sent")
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("scanner_alert_logs")
}

model StressTestResult {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  symbol       String
  timeframe    String
  testResultsJson String
  passedCount  Int
  verdict      String
  score        Float
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@map("scanner_stress_test_results")
}

model ForwardTestSignal {
  id            String   @id @default(cuid())
  strategyKey   String
  family        String
  symbol        String
  timeframe     String
  direction     String
  entryPrice    Float
  stopPrice     Float
  targetPrice   Float
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  signalAt      DateTime @default(now())
  barTime       Int?
  outcome       String?
  exitPrice     Float?
  exitAt        DateTime?
  rMultiple     Float?
  barsToExit    Int?
  resolved      Boolean  @default(false)

  @@index([strategyKey])
  @@index([symbol])
  @@index([signalAt])
  @@index([resolved])
  @@map("scanner_forward_test_signals")
}

// Cross-sweep dedupe: only the FIRST alert for a given signalKey is dispatched.
// signalKey = `${strategyKey}:${symbol}:${timeframe}:${direction}:${barTime}`
// Pruned after 7 days by dispatchAlerts().
model DispatchedSignal {
  id           String   @id @default(cuid())
  signalKey    String   @unique
  strategyKey  String
  symbol       String
  timeframe    String
  direction    String
  score        Float
  channel      String
  dispatchedAt DateTime @default(now())

  @@index([dispatchedAt])
  @@index([symbol])
  @@map("scanner_dispatched_signals")
}

// Per-symbol data freshness tracking — written every sweep, surfaced in the
// Discord summary so silent Yahoo failures are visible.
model SymbolDataStatus {
  id            String   @id @default(cuid())
  symbol        String
  timeframe     String
  candles       Int
  lastBarTime   Int?
  lastLivePrice Float?
  source        String   @default("live")  // "live" | "stale" | "csv" | "failed"
  error         String?
  checkedAt     DateTime @default(now())

  @@unique([symbol, timeframe])
  @@index([checkedAt])
  @@map("scanner_symbol_data_status")
}
