generator client {
  provider = "prisma-client-js"
}

// Local dev: SQLite (DATABASE_URL="file:./db/scanner.db")
// Vercel prod: Postgres (DATABASE_URL="postgresql://...")
// The build runs scripts/swap-provider.ts which flips provider to "postgresql"
// when DATABASE_URL starts with "postgres", so deploys need no manual edit.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ScanResult {
  id            String   @id @default(cuid())
  strategyKey   String
  strategyType  String
  symbol        String
  timeframe     String
  direction     String
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  entryPrice    Float?
  stopPrice     Float?
  targetPrice   Float?
  barTime       Int?
  scannedAt     DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([symbol, timeframe])
  @@index([strategyKey])
  @@index([createdAt])
  @@map("scanner_scan_results")
}

model BacktestByGrade {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  label        String
  symbol       String
  timeframe    String
  winRate      Float
  profitFactor Float
  maxDrawdown  Float
  totalTrades  Int
  avgRR        Float   @default(0)
  gradeAPlus   Int     @default(0)
  gradeA       Int     @default(0)
  gradeBPlus   Int     @default(0)
  gradeBMinus  Int     @default(0)
  gradeC       Int     @default(0)
  avgScore     Float   @default(0)
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@index([family])
  @@map("scanner_backtest_by_grade")
}

model AlertConfigScanner {
  id            String   @id @default(cuid())
  name          String
  channel       String
  destination   String
  minScore      Float    @default(50)
  strategyTypes String   @default("all")
  symbols       String   @default("all")
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([enabled])
  @@map("scanner_alert_configs")
}

model AlertLogScanner {
  id          String   @id @default(cuid())
  configId    String?
  channel     String
  destination String
  subject     String
  body        String
  status      String   @default("sent")
  error       String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("scanner_alert_logs")
}

model StressTestResult {
  id           String   @id @default(cuid())
  strategyKey  String
  family       String
  symbol       String
  timeframe    String
  testResultsJson String
  passedCount  Int
  verdict      String
  score        Float
  createdAt    DateTime @default(now())

  @@index([strategyKey])
  @@map("scanner_stress_test_results")
}

model ForwardTestSignal {
  id            String   @id @default(cuid())
  strategyKey   String
  family        String
  symbol        String
  timeframe     String
  direction     String
  entryPrice    Float
  stopPrice     Float
  targetPrice   Float
  score         Float
  grade         String?
  reasonsJson   String   @default("[]")
  signalAt      DateTime @default(now())
  barTime       Int?
  outcome       String?
  exitPrice     Float?
  exitAt        DateTime?
  rMultiple     Float?
  barsToExit    Int?
  resolved      Boolean  @default(false)

  // Unique on (strategy, symbol, tf, direction, barTime) — prevents the same
  // setup being written 6× per day for a persistent daily signal. barTime is
  // nullable for legacy signals but unique constraints treat NULLs as distinct
  // in Postgres/SQLite, so only non-null barTime rows get enforced dedupe.
  @@unique([strategyKey, symbol, timeframe, direction, barTime])
  @@index([strategyKey])
  @@index([symbol])
  @@index([signalAt])
  @@index([resolved])
  @@map("scanner_forward_test_signals")
}

// Cross-sweep dedupe: only the FIRST alert for a given signalKey is dispatched.
// signalKey = `${strategyKey}:${symbol}:${timeframe}:${direction}:${barTime}`
// Pruned after 7 days by dispatchAlerts().
model DispatchedSignal {
  id           String   @id @default(cuid())
  signalKey    String   @unique
  strategyKey  String
  symbol       String
  timeframe    String
  direction    String
  score        Float
  channel      String
  dispatchedAt DateTime @default(now())

  @@index([dispatchedAt])
  @@index([symbol])
  @@map("scanner_dispatched_signals")
}

// Per-symbol data freshness tracking — written every sweep, surfaced in the
// Discord summary so silent Yahoo failures are visible.
model SymbolDataStatus {
  id            String   @id @default(cuid())
  symbol        String
  timeframe     String
  candles       Int
  lastBarTime   Int?
  lastLivePrice Float?
  source        String   @default("live")  // "live" | "stale" | "csv" | "failed"
  error         String?
  checkedAt     DateTime @default(now())

  @@unique([symbol, timeframe])
  @@index([checkedAt])
  @@map("scanner_symbol_data_status")
}

// ════════════════════════════════════════════════════════════════════════
// PAPER TRADING — virtual trade tracking + account equity
// ════════════════════════════════════════════════════════════════════════

model PaperTrade {
  id            String   @id @default(cuid())
  // Links to the dispatched setup (matches DispatchedSignal.signalKey)
  setupKey      String   @unique
  strategyKey   String
  symbol        String
  timeframe     String
  direction     String   // "long" | "short"
  // Trade parameters (from the setup's best signal)
  entryPrice    Float
  stopPrice     Float
  targetPrice   Float
  score         Float
  grade         String?
  familiesJson  String   @default("[]")
  // Position sizing (from risk.ts)
  lots          Float    @default(0)
  riskAmount    Float    @default(0)
  pipValuePerLot Float  @default(0)
  // Trade lifecycle
  status        String   @default("open")  // "open" | "win" | "loss" | "timeout"
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  exitPrice     Float?
  barsToExit    Int?
  realizedR     Float?    // +2.0 = 2R win, -1.0 = 1R loss
  realizedPnl   Float?    // in USD
  // Regime when the trade was opened (for later analysis)
  regime        String?

  @@index([status])
  @@index([symbol])
  @@index([openedAt])
  @@index([closedAt])
  @@map("scanner_paper_trades")
}

// Tracks running account equity. There's one row (id="main") that gets
// updated as trades close. Initialized from PAPER_TRADE_BALANCE env var
// (default $10,000) on first use.
model PaperTradeAccount {
  id            String   @id @default("main")
  startingBalance Float  @default(10000)
  currentBalance Float  @default(10000)
  totalTrades   Int      @default(0)
  totalWins     Int      @default(0)
  totalLosses   Int      @default(0)
  totalTimeouts Int      @default(0)
  totalRealizedR Float   @default(0)
  totalRealizedPnl Float @default(0)
  openRisk      Float    @default(0)  // sum of riskAmount for open trades
  updatedAt     DateTime @updatedAt

  @@map("scanner_paper_trade_account")
}
