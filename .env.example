DATABASE_URL="file:./db/scanner.db"

# Discord webhook (one channel, signals with score >= 70):
# 1. Discord → your server → create a #scanner-signals channel
# 2. Channel settings → Integrations → Webhooks → Create Webhook
# 3. Copy the URL below
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Optional: Telegram alerts
# TELEGRAM_BOT_TOKEN=""

# Optional: Email alerts
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
